# LeakFinder Configuration
# Copy this file to .env and fill in your API keys

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=0
PORT=5000

# Request Settings
MAX_RESULTS_PER_PROVIDER=25
REQUEST_TIMEOUT=15
USER_AGENT=LeakFinder/1.0 (+https://example.com)

# Code Repository Providers
# GitHub - Free tier: 60 requests/hour without token, 5000/hour with token
GITHUB_TOKEN=ghp_your_github_token_here

# GitLab - Free tier available
GITLAB_TOKEN=glpat-your_gitlab_token_here

# Bitbucket - Requires app password
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password

# Sourcegraph - Free tier available
SOURCEGRAPH_TOKEN=sgp_your_sourcegraph_token_here

# Search Providers
# Google Custom Search - Free tier: 100 queries/day
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id

# Security/OSINT Providers
# Shodan - Free tier: 100 queries/month
SHODAN_API_KEY=your_shodan_api_key

# Have I Been Pwned - Paid API required for pastes
HIBP_API_KEY=your_hibp_api_key

# Note: Pastebin and Wayback Machine providers work without API keys
# but may have rate limits or reduced functionality
